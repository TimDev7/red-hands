@icon("uid://bdbkim4cpo8c3")
extends ItemData
##Класс для предметов которые могут наносить урон - оружий. 
class_name WeaponData

enum Type {
	##Пустой тип. Используется при инициализации.
	None, 
	##Ближний тип.
	Melee, 
	##Дальнобойный тип.
	Distance, 
	##Урожие для быстрых атак.
	Dagger
	}

##Базовый урон от оружия.
@export var damage:int
##Множитель для добавочного урона. Добавочный урон может как повышать урон, так и понизить его.
@export var extra_dmg_mult:float = 0.0
##Тип оружия. В зависимости от типа, мини-игра при атаке будет меняться.
@export var type:Type
