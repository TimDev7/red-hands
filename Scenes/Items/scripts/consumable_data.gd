@icon("uid://v7by0ukdmsyi")
extends ItemData
##Класс для предметов, которые можно использовать и получить эффект.
class_name ConsumableData

enum Effect {
	##Пустой эффект. Используется при инициализации.
	None,
	##Эффект лечения. Восполняет здоровье.
	Heal,
	##Эффект урона. Понижает здоровье.
	Damage,
	##Эффект силы. Дает пассивную прибавку к силе.
	Strength
	}

##Эффект от использования предмета.
@export var effect:Effect
##Значение для эффекта. Не рекомендуется задавать отрицательные значения для избежания неоднозначности эффекта.
@export var effect_value:float
