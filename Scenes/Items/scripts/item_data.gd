@icon("uid://b260rtk1vlebw")
extends Resource
##Основной класс для предметов.
class_name ItemData

##Уникальный id предмета. Не используйте один и тот же id дважды, чтобы избежать ошибок.
@export var id:String = ""
##Имя для предмета. Это свойство используется для отображения имени предмета в UI. 
@export var name:String = ""
##Описание предмета. Описание, для понимания свойств предмета.
@export var description:String = ""
##Иконка для предмета. Используется для отображения предмета в игре.
@export var icon:Texture2D
##Максимальное количество предмета в одной ячейке инвентаря.
@export var stack:int = 64
