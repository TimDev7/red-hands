; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Red Hands"
config/description="Red Hands - built on Core Template (III generation) with Entropy's Curse gameplay."
config/tags=PackedStringArray("2026", "wip")
run/main_scene="uid://bphgukl5gnkle"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="uid://cxyewa58ncabk"
config/defaults/default_clear_color=Color(0.3, 0.3, 0.3, 1)

[audio]

buses/default_bus_layout=""

[autoload]

Core="*res://Template/Core/Core.tscn"
Game="*res://Game/Game.tscn"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1200
window/size/viewport_height=540
window/size/mode=4
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/handheld/orientation=1
window/vsync/vsync_mode=0
mouse_cursor/custom_image="uid://bas0lwxqpcow3"
mouse_cursor/custom_image_hotspot=Vector2(12, 12)

[file_customization]

folder_colors={
"res://Template/": "pink",
"res://Tools/": "yellow"
}

[global_group]

Button=""
ButtonIcon=""

[importer_defaults]

cubemap_texture={
&"compress/mode": 0
}

